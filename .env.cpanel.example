# Biến môi trường cho bản build frontend chạy trên cPanel
# Copy thành .env.cpanel rồi chạy: npm run package:cpanel

# Node.js App (backend) trên cPanel được gắn với subdomain này
VITE_API_URL=https://api.phanmemauto.com

# Upload file lớn đi thẳng lên R2 qua presigned URL, nên dùng chung domain API
VITE_UPLOAD_API_URL=https://api.phanmemauto.com

# Gemini API (nếu cần)
GEMINI_API_KEY=
