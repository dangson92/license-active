PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=license_user
DB_PASS=your_password
DB_NAME=license_db
JWT_SECRET=change_me_jwt_secret
DEVICE_SALT=change_me_device_salt

# RSA Keys (File-based)
# Generate keys: openssl genrsa -out keys/private.pem 2048
#                openssl rsa -in keys/private.pem -pubout -out keys/public.pem
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem

FRONTEND_URL=https://license.dangthanhson.com

# iDrive E2 Cloud Storage Configuration
# Get credentials from: https://www.idrive.com/e2/
IDRIVE_E2_ENDPOINT=https://xxxxx.e2.idrivee2.com
IDRIVE_E2_ACCESS_KEY=your_access_key
IDRIVE_E2_SECRET_KEY=your_secret_key
IDRIVE_E2_BUCKET=your_bucket_name
IDRIVE_E2_PUBLIC_URL=https://your-public-url.com

# ===================================================================
# Cloud Storage — chọn nơi lưu file release/attachment mặc định
# 'r2' | 'idrive-e2'. Bỏ trống: tự ưu tiên R2, fallback iDrive E2.
# ===================================================================
STORAGE_PROVIDER=r2

# --- Cloudflare R2 ---
# Lấy credentials: Cloudflare Dashboard > R2 > Manage API Tokens
# Token cần quyền "Object Read & Write" trên bucket.
# Chỉ cần R2_ACCOUNT_ID (endpoint tự suy ra), hoặc khai báo thẳng R2_ENDPOINT.
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket_name
# BẮT BUỘC để file tải được công khai: custom domain đã gắn vào bucket,
# hoặc r2.dev subdomain (R2 > bucket > Settings > Public Development URL).
# Endpoint S3 ở trên KHÔNG public.
R2_PUBLIC_URL=https://dl.phanmemauto.com

# ===================================================================
# cPanel / Passenger: tắt scheduler trong process (process bị dừng khi rảnh)
# và chạy `node server/cron.js` mỗi giờ bằng Cron Jobs. Xem docs/CPANEL_DEPLOY.md
# ===================================================================
# DISABLE_INTERNAL_SCHEDULERS=1
